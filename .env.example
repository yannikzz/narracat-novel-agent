# ===== 默认 LLM endpoint: DeepSeek =====
# DeepSeek 官方支持 Anthropic-compatible API。
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=<your-deepseek-api-key>
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-pro
CLAUDE_CODE_MAX_CONTEXT_TOKENS=1000000

# ===== 切换 Anthropic 直连 =====
# 注释上面 ANTHROPIC_BASE_URL，改用 Anthropic API Key。
# ANTHROPIC_API_KEY=sk-ant-...

# ===== 语料服务（官方增值，可选）=====
# 维护者/官方构建才有 token；不配置则写作不注入真人范例（不影响其他功能）。
# NARRACAT_CORPUS_TOKEN=<corpus-service-token>
# NARRACAT_CORPUS_URL=https://corpus.narracat.com
# 维护者离线开发：指向语料服务私有仓本地 checkout 的 corpus/extracts 上级目录
# NARRACAT_CORPUS_DIR=/path/to/<语料服务仓>/corpus/extracts

# ===== macOS 公证凭证（仅发版打包 package:release 需要）=====
# 来自 App Store Connect → 用户和访问 → 集成 → App Store Connect API 新建的密钥。
# .p8 是私钥文件本体，只能下载一次，务必备份到密码管理器；此处只写它的路径，不写内容。
# Key ID / Issuer ID 不是秘密，只是标识符。
# 配置位置：推荐放在 .env.local（本地覆盖层，优先于 .env，符合 Vite 生态约定）；两个文件都不存在时默认档不需要凭证。
# APPLE_API_KEY=/Users/<你>/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
# APPLE_API_KEY_ID=XXXXXXXXXX
# APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ===== PostHog 读数据（仅维护者查运营数据，与构建/运行无关）=====
# 「读」的钥匙，和遥测 Worker 里那把「只写不读」的 Project API Key 是两回事（见 ADR-0039）。
# PostHog EU → 头像 → Personal API keys → Create key，Scopes 只勾 Query Read + Project Read，
# 并把 Scoped projects 限定到 NarraCat 项目。项目 ID 可由该 key 自动查得，无需配置。
# POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxx
